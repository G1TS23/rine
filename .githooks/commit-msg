#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits.
# Enable once per clone: git config core.hooksPath .githooks

subject=$(head -n 1 "$1")

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^A-Z].*[^.]$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must match 'type(scope): description'" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  lowercase description, no trailing period" >&2
  echo "  got: $subject" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters, 72 max" >&2
  exit 1
fi
